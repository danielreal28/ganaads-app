# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a GitHub (solo este ".env.example").

# Se la da Render automáticamente al crear la base de datos PostgreSQL.
# Cópiala desde el panel de Render (Internal Connection String).
DATABASE_URL=postgres://usuario:password@host:5432/nombre_basedatos

# Clave secreta para firmar los tokens de sesión (JWT).
# Genera una aleatoria larga, por ejemplo con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Puerto en el que corre el servidor (Render lo asigna solo, no lo toques ahí).
PORT=3000

# --- Configuración de recompensas (puntos) ---
# Puntos que gana el usuario por cada anuncio visto
POINTS_PER_AD=10

# Puntos de bono único que gana el que invita, cuando su referido ve su primer anuncio
POINTS_REFERRAL_BONUS=500

# Cuántos puntos equivalen a 1 USDT (ajusta según tu ingreso real por anuncio)
POINTS_PER_USDT=1000

# Mínimo de USDT para poder solicitar un retiro
MIN_WITHDRAWAL_USDT=5

# --- Google AdSense (versión web) ---
# Tu Publisher ID de AdSense, formato ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000
